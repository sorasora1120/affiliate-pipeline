# ============================================================
# 環境変数サンプル（実際の値を入れて .env にリネームして使用）
# GitHub Actions では Secrets / Variables に設定すること
# ============================================================

# --- A8.net ログイン情報 ---
A8_USERNAME=your_a8_login_id
A8_PASSWORD=your_a8_password

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- WordPress ---
# サイトURL（末尾スラッシュなし）
WP_SITE_URL=https://your-blog.example.com
# WordPress ログインユーザー名
WP_USERNAME=your_wp_username
# アプリケーションパスワード（管理画面 → ユーザー → プロフィール → アプリケーションパスワード）
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# 投稿ステータス: draft（下書き）または publish（即時公開）
WP_POST_STATUS=draft
# 投稿先カテゴリ ID（管理画面 → 投稿 → カテゴリ で確認）
WP_CATEGORY_ID=1

# --- Discord Webhook ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxx/xxxxxx

# --- 動作パラメータ（任意） ---
# スクレイピングする最低報酬額（円）
MIN_REWARD_YEN=5000
# 1回の実行で生成する最大記事数（API コスト抑制のため）
MAX_ARTICLES_PER_RUN=3
# 記事間のウェイト（秒）
ARTICLE_INTERVAL_SECONDS=30
