# ============================================================
# 環境変数サンプル（GitHub Actions の Secrets に登録する）
# ============================================================

# --- A8.net ログイン情報 ---
A8_USERNAME=your_a8_email@example.com
A8_PASSWORD=your_a8_password

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- はてなブログ ---
HATENA_ID=sorajima112                        # はてなID
HATENA_BLOG_DOMAIN=sorajima112.hatenablog.com # ブログドメイン
HATENA_API_KEY=xxxxxxxxxxxx                  # 詳細設定 → AtomPub → APIキー
HATENA_DRAFT=yes                             # yes=下書き / no=即時公開

# --- Discord Webhook ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxx/xxxxxx

# --- 動作パラメータ（任意） ---
MIN_REWARD_YEN=5000
MAX_ARTICLES_PER_RUN=3
ARTICLE_INTERVAL_SECONDS=30
